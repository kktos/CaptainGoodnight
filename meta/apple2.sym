# Apple II standard symbols: the ROM's zero page, then apple2io.sym (I/O, ROM)
sym A1L $3C
sym A1H $3D
sym A2L $3E
sym A2H $3F
sym BOOT_SLOT16 $2B
sym BOOT_TRACK $41
sym BOOT_SECT $3D
sym BOOT_PAGE $27
sym WNDLFT $20
sym WNDWDTH $21
sym WNDTOP $22
sym WNDBTM $23
sym CH $24
sym CV $25
sym BASL $28
sym BASH $29
sym INVFLG $32
sym CSWL $36
sym CSWH $37
sym KSWL $38
sym KSWH $39
sym RNDL $4E
sym RNDH $4F

include apple2io.sym
